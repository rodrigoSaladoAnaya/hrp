#!/usr/bin/env bash

set -euo pipefail

require_node() {
  if ! command -v node >/dev/null 2>&1; then
    echo "Error: HRP necesita Node.js 20 o posterior; agrega node a PATH antes de iniciar el MCP." >&2
    exit 1
  fi
}

run_cli() {
  local candidate="$1"
  require_node
  if [ -x "$candidate" ]; then
    exec "$candidate" mcp
  fi
  if [ -f "$candidate" ]; then
    exec node "$candidate" mcp
  fi
}

if [ -n "${HRP_CLI:-}" ]; then
  run_cli "$HRP_CLI"
  echo "Error: HRP_CLI no apunta a un ejecutable o archivo válido: $HRP_CLI" >&2
  exit 1
fi

if command -v hrp >/dev/null 2>&1; then
  require_node
  exec "$(command -v hrp)" mcp
fi

if [ -n "${HOME:-}" ]; then
  run_cli "$HOME/.local/bin/hrp"
fi

search_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
for _attempt in {1..8}; do
  if [ -f "$search_dir/bin/hrp.mjs" ]; then
    require_node
    exec node "$search_dir/bin/hrp.mjs" mcp
  fi
  parent="$(dirname "$search_dir")"
  [ "$parent" != "$search_dir" ] || break
  search_dir="$parent"
done

echo "Error: no se encontró el CLI hrp. Ejecuta scripts/install-codex.sh desde el repositorio de HRP o define HRP_CLI." >&2
exit 1
